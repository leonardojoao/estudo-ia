# =============================================================================
# .dockerignore — YouTube Automation
# Exclui arquivos desnecessários do contexto de build do Docker.
# Reduz o tamanho do contexto e evita vazar secrets para as imagens.
# =============================================================================

# Controle de versão
.git/
.gitignore
.github/

# Documentação (não necessária nas imagens)
docs/
*.md
!README.md

# Ambientes virtuais Python
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.so

# Dependências Node.js (recriadas no build com npm ci)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Artefatos de build (recriados no build)
dist/
build/
.vite/
*.egg-info/

# Testes e cobertura (não necessários em produção)
tests/
coverage/
htmlcov/
coverage.xml
.coverage
.pytest_cache/
*.spec.ts
*.test.ts
*.spec.py
*.test.py

# Configurações locais e secrets
.env
.env.*
!.env.example
secrets/
credentials/
client_secrets.json
oauth_tokens/
*.pem
*.key
*.cert

# Dados locais (persistidos via volumes, não na imagem)
data/
videos/
output/
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# IDE e editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# CI/CD
.github/
Makefile

# Scripts de desenvolvimento
scripts/

# Temporários
tmp/
temp/
