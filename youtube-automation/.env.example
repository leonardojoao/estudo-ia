# =============================================================================
# YouTube Automation — Variáveis de Ambiente
#
# Como usar:
#   cp .env.example .env
#   # Edite o .env com seus valores reais
#
# NUNCA faça commit do arquivo .env (já está no .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# OLLAMA — IA Local (geração de texto, título e descrição)
# -----------------------------------------------------------------------------

# URL do serviço Ollama.
#   - Com Docker Compose: use host.docker.internal (acessa o host a partir do container)
#   - Sem Docker (local):  use http://localhost:11434
#   - Rede personalizada:  use http://IP_DO_SERVIDOR:11434
OLLAMA_URL=http://host.docker.internal:11434

# Modelo padrão para geração de texto.
# Verifique os modelos instalados: ollama list
# Instale um modelo:               ollama pull llama3
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# PASTA DE VÍDEOS — Caminho no host (máquina local)
# -----------------------------------------------------------------------------

# Caminho ABSOLUTO para a pasta com seus vídeos fonte no host.
# Esta pasta é montada como volume read-only no container.
#
# Exemplos:
#   Linux/Mac:  /home/usuario/Videos/youtube-source
#   Windows:    C:\Users\Usuario\Videos\youtube-source
#   Relativo:   ./videos  (cria a pasta dentro do projeto — OK para testes)
VIDEOS_FOLDER_HOST=./videos

# -----------------------------------------------------------------------------
# SEGURANÇA — Chave secreta para criptografia
# -----------------------------------------------------------------------------

# Chave para criptografar tokens OAuth armazenados no banco.
#
# OBRIGATÓRIO EM PRODUÇÃO — nunca use o valor padrão!
#
# Como gerar uma chave segura:
#   Linux/Mac: openssl rand -hex 32
#   Windows:   python -c "import secrets; print(secrets.token_hex(32))"
#   Docker:    docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE-ESTA-CHAVE-ANTES-DE-USAR-EM-PRODUCAO

# -----------------------------------------------------------------------------
# BANCO DE DADOS — SQLite
# -----------------------------------------------------------------------------

# Path do arquivo SQLite dentro do container.
# O diretório /app/data é persistido pelo volume Docker 'db-data'.
# Não altere este valor a menos que saiba o que está fazendo.
DATABASE_PATH=/app/data/youtube_automation.db

# -----------------------------------------------------------------------------
# TTS — Síntese de Voz (edge-tts)
# -----------------------------------------------------------------------------

# Voz padrão para narração. Requer conexão com internet (API da Microsoft).
#
# Opções disponíveis em inglês:
#   en-US-JennyNeural     Feminina, neutra americana (recomendado)
#   en-US-GuyNeural       Masculina, neutra americana
#   en-US-AriaNeural      Feminina, expressiva americana
#   en-US-DavisNeural     Masculina, casual americana
#   en-GB-SoniaNeural     Feminina, britânica
#   en-GB-RyanNeural      Masculina, britânica
#   en-AU-NatashaNeural   Feminina, australiana
#   en-AU-WilliamNeural   Masculina, australiana
#   en-CA-ClaraNeural     Feminina, canadense
#   en-IN-NeerjaNeural    Feminina, indiana
#
# Liste todas as vozes: edge-tts --list-voices | grep en-
TTS_VOICE=en-US-JennyNeural

# -----------------------------------------------------------------------------
# PROCESSAMENTO DE VÍDEO
# -----------------------------------------------------------------------------

# Formato do vídeo final.
#   16:9  → YouTube normal (landscape)
#   9:16  → YouTube Shorts (portrait/vertical)
DEFAULT_DIMENSION=16:9

# Duração mínima de cada clipe para o algoritmo anti-plágio (segundos).
# Valor menor = mais cortes = mais variação
CLIP_MIN_DURATION=3

# Duração máxima de cada clipe para o algoritmo anti-plágio (segundos).
CLIP_MAX_DURATION=6

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------

# Porta exposta pelo backend FastAPI no host
BACKEND_PORT=8000

# Porta exposta pelo frontend Nginx no host
# Nota: em dev (docker-compose.dev.yml), o frontend roda na porta 5173
FRONTEND_PORT=80

# Ambiente: production | development | testing
ENVIRONMENT=production

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG em desenvolvimento para logs detalhados do pipeline
LOG_LEVEL=INFO

# Origens permitidas para CORS (separadas por vírgula, sem espaços)
# Em produção, liste apenas as origens que realmente acessam a API
CORS_ORIGINS=http://localhost,http://localhost:80

# Número de workers para processamento paralelo de vídeo
# Recomendado: (número de CPUs) - 1, mínimo 1
# SQLite não beneficia de múltiplos writers, mas tasks CPU-bound sim
MAX_WORKERS=2
