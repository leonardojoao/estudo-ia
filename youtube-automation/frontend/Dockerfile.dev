# =============================================================================
# Frontend Dockerfile — Modo Desenvolvimento
# Usado pelo docker-compose.dev.yml
#
# Características:
#   - Vite dev server com Hot Module Replacement (HMR)
#   - Código-fonte montado como volume (sem COPY — apenas dependências)
#   - Porta 5173
# =============================================================================
FROM node:20-alpine

WORKDIR /app

# Instala dependências (o código-fonte é montado via volume no compose)
COPY package*.json ./
RUN npm install

# Porta do servidor de desenvolvimento Vite
EXPOSE 5173

# Inicia o Vite dev server acessível externamente (necessário para Docker)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
